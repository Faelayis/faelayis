{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "me",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"observability": {
		"enabled": true,
	},
}
